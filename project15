print("===== STUDENT MARKSHEET GENERATOR =====")

name = input("Enter student name: ")
roll = input("Enter roll number: ")

print("\nEnter marks for 5 subjects:")

maths = float(input("Maths: "))
physics = float(input("Physics: "))
python = float(input("Python: "))
english = float(input("English: "))
computer = float(input("Computer: "))

total = maths + physics + python + english + computer
percentage = total / 5

if percentage >= 90:
    grade = "A"
elif percentage >= 80:
    grade = "B"
elif percentage >= 70:
    grade = "C"
elif percentage >= 60:
    grade = "D"
else:
    grade = "F"

if percentage >= 40:
    result = "PASS"
else:
    result = "FAIL"

print("\n===== MARKSHEET =====")
print("Student Name:", name)
print("Roll Number:", roll)

print("\nSubject Marks:")
print("Maths:", maths)
print("Physics:", physics)
print("Python:", python)
print("English:", english)
print("Computer:", computer)

print("\nTotal Marks:", total, "/ 500")
print("Percentage:", round(percentage, 2), "%")
print("Grade:", grade)
print("Result:", result)

print("\nMarksheet generated successfully!")